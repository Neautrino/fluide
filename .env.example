# Copy to .env next to docker-compose.yml. Every value here is optional.
#
# Do not put database passwords or the vault key here: secrets-init generates
# them on first start and keeps them in Docker volumes.
# Plaid client id and secret are entered in the app (Settings -> Provider keys).
#
# OPENAI_API_KEY and OPENCODE_API_KEY also accept a _FILE variant
# (OPENAI_API_KEY_FILE, OPENCODE_API_KEY_FILE): a path inside the container to a
# file holding the key. It is used only when the plain variable is unset.

# Plaid environment: production (real banks; needs Plaid's approval, the default) or sandbox (Plaid's test banks).
PLAID_ENV=production

# Enables the Assistant; your questions and ledger query results are sent to OpenAI.
OPENAI_API_KEY=

# Enables AI categorization; transaction descriptions are sent to opencode.ai (Jev model).
OPENCODE_API_KEY=

# Advanced: extra comma-separated hostnames accepted in the Host header (only behind your own authenticating reverse proxy).
# FLUIDE_ALLOWED_HOSTS=
